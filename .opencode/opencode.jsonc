{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "**/worker-configuration.d.ts": "ask",
    },
    "bash": {
      "bun run lint": "allow",
      "bun run lint:fix": "allow",
    },
  },
  "mcp": {
    "bun-docs": {
      "type": "remote",
      "url": "https://bun.com/docs/mcp",
    },
  },
}
